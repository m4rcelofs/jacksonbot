<?xml version="1.0" encoding="UTF-8"?>
<cronentries>

	<cron>
		<url>/admin/start</url>
		<description>Starts JacksonBot</description>
		<schedule>every 2 hours from 06:30 to 18:30</schedule>
		<timezone>America/Los_Angeles</timezone>
	</cron>
	
	<cron>
		<url>/admin/start?from=yesterday</url>
		<description>Starts JacksonBot to check last users for the day</description>
		<schedule>every day 00:55</schedule>
		<timezone>America/Los_Angeles</timezone>
	</cron>

</cronentries>